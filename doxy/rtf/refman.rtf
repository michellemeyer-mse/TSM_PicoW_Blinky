00058     uint8_t res;\par
00059     \par
00060     {\cf19 if} (McuUtility_strcmp(({\cf18 char}*)cmd, McuShell_CMD_HELP)==0) \{\par
00061         *handled = {\cf17 true};\par
00062         McuShell_SendStr(({\cf18 unsigned} {\cf18 char}*){\cf22 "Sample program. Type in numbers, separated by spaces. Press <ENTER> at the end.\\r\\n"}, io->stdOut);\par
00063     \} {\cf19 else} {\cf19 if} (*cmd>={\cf23 '0'} && *cmd<={\cf23 '9'}) \{\par
00064         {\cf18 int} argc;\par
00065         {\cf18 char} *argv[64];\par
00066         {\cf18 unsigned} {\cf18 char} *arg;\par
00067         {\cf18 unsigned} {\cf18 char} *p;\par
00068         {\cf18 size_t} len;\par
00069         \par
