\par
\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid cmake --build --list-presets\par
cmake --build --preset app-debug\par
cmake --build --preset app-release\par
cmake --build --preset app-test\par
}
\par
Test: {
\par
\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid cmake --preset Test\par
cmake --build --preset app-test\par
ctest --list-presets\par
ctest --test-dir build/Test -R Led_1\par
}
\par}
