00071         {\cf17 extern} {\cf18 void} allocMem(uint32_t);\par
00072         allocMem(xTaskGetTickCount());\par
00073         argc = 0;\par
00074         argv[argc++] = {\cf22 "sample"};\par
00075         len = McuUtility_strlen(cmd);\par
00076         arg = malloc(len+1);\par
00077         {\cf19 if} (arg==NULL) \{\par
00078             {\cf19 return} ERR_FAILED;\par
