00034 {\cf20  */}\par
00035 {\cf21 #define _PID_MAP(itf, n)  ( (CFG_TUD_##itf) << (n) )}\par
00036 {\cf21 #define USB_PID           (0x4000 | _PID_MAP(CDC, 0) | _PID_MAP(MSC, 1) | _PID_MAP(HID, 2) | \\}\par
00037 {\cf21                            _PID_MAP(MIDI, 3) | _PID_MAP(VENDOR, 4) )}\par
00038 \par
00039 {\cf21 #define USB_VID   0xCafe}\par
00040 {\cf21 #define USB_BCD   0x0200}\par
00041 \par
00042 {\cf20 //--------------------------------------------------------------------+}\par
00043 {\cf20 // Device Descriptors}\par
00044 {\cf20 //--------------------------------------------------------------------+}\par
00045 tusb_desc_device_t {\cf17 const} desc_device =\par
00046 \{\par
00047   .bLength            = {\cf17 sizeof}(tusb_desc_device_t),\par
00048   .bDescriptorType    = TUSB_DESC_DEVICE,\par
00049   .bcdUSB             = USB_BCD,\par
00050 \par
00051   {\cf20 // Use Interface Association Descriptor (IAD) for CDC}\par
00052   {\cf20 // As required by USB Specs IAD's subclass must be common class (2) and protocol must be IAD (1)}\par
00053   .bDeviceClass       = TUSB_CLASS_MISC,\par
00054   .bDeviceSubClass    = MISC_SUBCLASS_COMMON,\par
00055   .bDeviceProtocol    = MISC_PROTOCOL_IAD,\par
00056 \par
00057   .bMaxPacketSize0    = CFG_TUD_ENDPOINT0_SIZE,\par
00058 \par
00059   .idVendor           = USB_VID,\par
00060   .idProduct          = USB_PID,\par
00061   .bcdDevice          = 0x0100,\par
00062 \par
00063   .iManufacturer      = 0x01,\par
00064   .iProduct           = 0x02,\par
00065   .iSerialNumber      = 0x03,\par
00066 \par
00067   .bNumConfigurations = 0x01\par
00068 \};\par
00069 \par
00070 {\cf20 // Invoked when received GET DEVICE DESCRIPTOR}\par
00071 {\cf20 // Application return pointer to descriptor}\par
00072 uint8_t {\cf17 const} * tud_descriptor_device_cb({\cf18 void})\par
00073 \{\par
00074   {\cf19 return} (uint8_t {\cf17 const} *) &desc_device;\par
00075 \}\par
00076 \par
00077 {\cf20 //--------------------------------------------------------------------+}\par
00078 {\cf20 // Configuration Descriptor}\par
00079 {\cf20 //--------------------------------------------------------------------+}\par
00080 \par
00081 {\cf17 enum}\par
00082 \{\par
00083   ITF_NUM_CDC = 0,\par
00084   ITF_NUM_CDC_DATA,\par
00085   ITF_NUM_TOTAL\par
00086 \};\par
00087 \par
00088 {\cf21 #define EPNUM_CDC_NOTIF   0x81}\par
00089 {\cf21 #define EPNUM_CDC_OUT     0x02}\par
00090 {\cf21 #define EPNUM_CDC_IN      0x82}\par
00091 \par
00092 {\cf21 #define CONFIG_TOTAL_LEN    (TUD_CONFIG_DESC_LEN + TUD_CDC_DESC_LEN)}\par
00093 \par
00094 {\cf20 // full speed configuration}\par
00095 uint8_t {\cf17 const} desc_fs_configuration[] =\par
00096 \{\par
00097   {\cf20 // Config number, interface count, string index, total length, attribute, power in mA}\par
00098   TUD_CONFIG_DESCRIPTOR(1, ITF_NUM_TOTAL, 0, CONFIG_TOTAL_LEN, 0x00, 100),\par
00099 \par
00100   {\cf20 // Interface number, string index, EP notification address and size, EP data address (out, in) and size.}\par
00101   TUD_CDC_DESCRIPTOR(ITF_NUM_CDC, 4, EPNUM_CDC_NOTIF, 8, EPNUM_CDC_OUT, EPNUM_CDC_IN, 64),\par
00102 \};\par
00103 \par
00104 {\cf20 // Invoked when received GET CONFIGURATION DESCRIPTOR}\par
00105 {\cf20 // Application return pointer to descriptor}\par
00106 {\cf20 // Descriptor contents must exist long enough for transfer to complete}\par
00107 uint8_t {\cf17 const} * tud_descriptor_configuration_cb(uint8_t index)\par
00108 \{\par
00109   (void) index; {\cf20 // for multiple configurations}\par
00110   {\cf19 return} desc_fs_configuration;\par
00111 \}\par
00112 \par
00113 {\cf20 //--------------------------------------------------------------------+}\par
00114 {\cf20 // String Descriptors}\par
00115 {\cf20 //--------------------------------------------------------------------+}\par
00116 \par
00117 {\cf20 // array of pointer to string descriptors}\par
00118 {\cf18 char} {\cf17 const}* string_desc_arr [] =\par
00119 \{\par
00120   ({\cf17 const} {\cf18 char}[]) \{ 0x09, 0x04 \}, {\cf20 // 0: is supported language is English (0x0409)}\par
00121   {\cf22 "TinyUSB"},                     {\cf20 // 1: Manufacturer}\par
00122   {\cf22 "TinyUSB Device"},              {\cf20 // 2: Product}\par
00123   {\cf22 "123456789012"},                {\cf20 // 3: Serials, should use chip ID}\par
00124   {\cf22 "TinyUSB CDC"},                 {\cf20 // 4: CDC Interface}\par
00125 \};\par
00126 \par
00127 {\cf17 static} uint16_t _desc_str[32];\par
00128 \par
00129 {\cf20 // Invoked when received GET STRING DESCRIPTOR request}\par
00130 {\cf20 // Application return pointer to descriptor, whose contents must exist long enough for transfer to complete}\par
00131 uint16_t {\cf17 const}* tud_descriptor_string_cb(uint8_t index, uint16_t langid)\par
00132 \{\par
00133   (void) langid;\par
00134 \par
00135   uint8_t chr_count;\par
00136 \par
00137   {\cf19 if} ( index == 0)\par
00138   \{\par
00139     memcpy(&_desc_str[1], string_desc_arr[0], 2);\par
00140     chr_count = 1;\par
00141   \}{\cf19 else}\par
00142   \{\par
00143     {\cf20 // Note: the 0xEE index string is a Microsoft OS 1.0 Descriptors.}\par
00144     {\cf20 // https://docs.microsoft.com/en-us/windows-hardware/drivers/usbcon/microsoft-defined-usb-descriptors}\par
00145 \par
00146     {\cf19 if} ( !(index < {\cf17 sizeof}(string_desc_arr)/{\cf17 sizeof}(string_desc_arr[0])) ) {\cf19 return} NULL;\par
00147 \par
00148     {\cf17 const} {\cf18 char}* str = string_desc_arr[index];\par
00149 \par
00150     {\cf20 // Cap at max char}\par
00151     chr_count = (uint8_t) strlen(str);\par
00152     {\cf19 if} ( chr_count > 31 ) chr_count = 31;\par
00153 \par
00154     {\cf20 // Convert ASCII string into UTF-16}\par
00155     {\cf19 for}(uint8_t i=0; i<chr_count; i++)\par
00156     \{\par
00157       _desc_str[1+i] = str[i];\par
00158     \}\par
00159   \}\par
00160 \par
00161   {\cf20 // first byte is length (including header), second byte is string type}\par
00162   _desc_str[0] = (TUSB_DESC_STRING << 8 ) | (2*chr_count + 2);\par
00163 \par
00164   {\cf19 return} _desc_str;\par
00165 \}\par
}

